# ===== LP Bot 設定 =====
# このファイルを .env にコピーして編集してください（.env は GitHub に上げない）

# 動作モード: monitor = 監視のみ（資金は一切動かさない）
MODE=monitor

# Arbitrum の RPC。公開RPCは制限が厳しいので、本番は Alchemy / Infura 等の自分用URL推奨
RPC_URL=https://arb1.arbitrum.io/rpc

# 監視するウォレット（monitor モードでは秘密鍵は不要）
WALLET_ADDRESS=0x3E3550856d19fD6e76C22F6fC46A9E4929a1160a

# 対象プール: Arbitrum WETH/USDC 0.05%
POOL_ADDRESS=0xC6962004f452bE9203591991D15f6b388e09E8D0

# 新しいレンジの幅（現在価格から ±何%）
RANGE_WIDTH_PCT=5

# レンジ外がこの分数続いたらリバランス対象と判定（価格の一時的なはみ出しで動かないため）
REBALANCE_DELAY_MIN=30

# 監視間隔（秒）
POLL_INTERVAL_SEC=60

# 管理画面（空欄なら送信しない）
DASHBOARD_URL=https://uniswap.test-test.me/lpbot/api/report.php
# GitHub Secrets の BOT_TOKEN と同じ値にする（長いランダム文字列）
BOT_TOKEN=

# ===== 実取引（MODE=live）用の設定 =====
# ※ live にする前に、必ず Bot 専用の新しいウォレットを作り、少額だけ入れてください
# Bot 専用ウォレットの秘密鍵（live のときだけ必要。絶対に他人に見せない・GitHub に上げない）
PRIVATE_KEY=

# 運用に使う上限額（USDC 建て）。ウォレットにこれ以上あっても使わない
MAX_DEPLOY_VALUE=100
# これ未満の資金では新規ポジションを作らない（USDC 建て）
MIN_OPEN_VALUE=10
# ポジションが無いとき自動で作るか（true / false）
AUTO_OPEN=true
# スワップ・流動性操作の許容スリッページ（%）
SLIPPAGE_PCT=0.5
# 現在価格と5分平均の差がこれ以上なら操作しない（急変・価格操作対策, %）
MAX_PRICE_DEVIATION_PCT=1
# ガス代として残す ETH（この2倍を残し、残りは WETH に変換して運用）
MIN_ETH_FOR_GAS=0.0005
WRAP_EXCESS_ETH=true
# 24時間あたりのリバランス上限回数
MAX_REBALANCES_PER_DAY=6
# この金額（USDC 建て）未満のスワップは行わない
MIN_SWAP_VALUE=1
